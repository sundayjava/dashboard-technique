# Image for both the web app and the scheduled vault jobs.
#
# ONE IMAGE ON PURPOSE. Coolify's scheduled tasks run a command inside an
# application's own container, so the cron scripts have to live in the same
# image the site runs from. A slimmer runtime (Next's `standalone` output)
# would drop scripts/, src/ and tsx and the jobs would have nowhere to run.
#
# Debian slim rather than Alpine: Prisma's query engine wants glibc and
# OpenSSL, and chasing musl builds is not worth the few MB here.
FROM node:22-slim AS base
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Dependencies first, so a code change does not reinstall the world.
# `npm ci` without --omit=dev on purpose: tsx is a devDependency and the
# scheduled jobs are run with it.
FROM base AS deps
COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npm ci

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# A PLACEHOLDER, NOT A SECRET, AND BUILD-STAGE ONLY.
#
# src/lib/prisma.ts throws at import time when DATABASE_URL is unset, and
# Next's "collecting page data" step imports every API route -- so the build
# fails without one even though nothing connects. The real value is injected
# at runtime by Coolify; this never reaches the final image, because the
# runner stage starts from `base` again.
ENV DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build?schema=public"
# Prisma's client is generated by postinstall, but the build stage copies
# node_modules in rather than installing, so it is generated explicitly.
RUN npx prisma generate && npm run build

FROM base AS runner
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /app/public ./public
# Kept so `tsx scripts/...` can run inside this container as a scheduled task.
COPY --from=build /app/src ./src
COPY --from=build /app/scripts ./scripts
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/prisma.config.ts ./prisma.config.ts
COPY --from=build /app/tsconfig.json ./tsconfig.json
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/next.config.ts ./next.config.ts

EXPOSE 3000
CMD ["npm", "start"]
