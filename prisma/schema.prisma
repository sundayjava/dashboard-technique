generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String               @id @default(cuid())
  email                      String               @unique
  emailVerified              Boolean              @default(false)
  emailVerificationOTP       String?
  emailVerificationOTPExpiry DateTime?
  passwordResetToken         String?              @unique
  passwordResetExpiry        DateTime?
  name                       String?
  password                   String
  transactionPin             String
  phoneNumber                String
  countryCode                String
  accountType                AccountType          @default(PERSONAL)
  currency                   String
  authorizationCode          String               @unique
  avatar                     String?
  dateOfBirth                DateTime?
  address                    String?
  profileCompleted           Boolean              @default(false)
  role                       Role                 @default(USER)
  isPlusUser                 Boolean              @default(false)
  canTransfer                Boolean              @default(true)
  accountDisabled            Boolean              @default(false)
  isVerified                 Boolean              @default(false)
  requireOTPForInternational Boolean              @default(false)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  transferDisabled           Boolean              @default(false)
  accounts                   Account[]
  activityLogs               ActivityLog[]
  processedBankDeposits      BankDeposit[]        @relation("ProcessedBankDeposits")
  bankDeposits               BankDeposit[]
  cardApplications           CardApplication[]
  processedChequeDeposits    ChequeDeposit[]      @relation("ProcessedCheques")
  chequeDeposits             ChequeDeposit[]
  cryptoDeposits             CryptoDeposit[]
  investmentAccess           InvestmentAccess[]
  investments                Investment[]
  kycSubmission              KYC?
  loanApplications           Loan[]
  receivedMessages           Message[]            @relation("ReceivedMessages")
  sentMessages               Message[]            @relation("SentMessages")
  notifications              Notification[]
  createdTradeKeys           TradeKey[]           @relation("CreatedTradeKeys")
  ownedTradeKeys             TradeKey[]           @relation("OwnedTradeKeys")
  transactions               Transaction[]
  assignedBankAccounts       UserBankAccount[]
  depositAddresses           UserDepositAddress[]

  @@map("users")
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String
  published Boolean  @default(false)
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}

model FAQ {
  id        String   @id @default(cuid())
  category  String
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("faqs")
}

model Message {
  id         String   @id @default(cuid())
  subject    String?
  content    String
  isRead     Boolean  @default(false)
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@index([createdAt])
  @@map("messages")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Loan {
  id         String     @id @default(cuid())
  userId     String
  fromDate   DateTime
  fullName   String
  amount     Float
  duration   Int
  loanType   LoanType
  reason     String
  status     LoanStatus @default(PENDING)
  adminNotes String?
  approvedBy String?
  approvedAt DateTime?
  rejectedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("loans")
}

model CryptoToken {
  id           String          @id @default(cuid())
  name         String
  symbol       String
  network      String
  address      String
  icon         String?
  isActive     Boolean         @default(true)
  exchangeRate Float           @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deposits     CryptoDeposit[]

  @@unique([symbol, network])
  @@index([isActive])
  @@map("crypto_tokens")
}

model CryptoDeposit {
  id            String              @id @default(cuid())
  userId        String
  tokenId       String
  amount        Float
  transactionId String
  status        CryptoDepositStatus @default(PENDING)
  adminNotes    String?
  verifiedBy    String?
  verifiedAt    DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  token         CryptoToken         @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenId])
  @@index([status])
  @@index([createdAt])
  @@map("crypto_deposits")
}

model CardApplication {
  id            String     @id @default(cuid())
  userId        String
  phoneNumber   String
  accountNumber String
  cardType      CardType
  status        CardStatus @default(PENDING)
  adminNotes    String?
  approvedBy    String?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("card_applications")
}

model Account {
  id               String        @id @default(cuid())
  userId           String
  accountNumber    String        @unique
  accountName      String
  accountType      AccountType   @default(PERSONAL)
  currency         String        @default("USD")
  balance          Float         @default(0)
  availableBalance Float         @default(0)
  status           AccountStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     Transaction[]

  @@index([userId])
  @@index([accountNumber])
  @@index([status])
  @@map("accounts")
}

model Transaction {
  id               String            @id @default(cuid())
  userId           String
  accountId        String
  transactionType  TransactionType
  amount           Float
  balanceAfter     Float
  currency         String
  description      String
  reference        String            @unique
  status           TransactionStatus @default(COMPLETED)
  recipientName    String?
  recipientAccount String?
  senderName       String?
  senderAccount    String?
  fee              Float             @default(0)
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([transactionType])
  @@index([status])
  @@index([createdAt])
  @@index([reference])
  @@map("transactions")
}

model KYC {
  id                 String       @id @default(cuid())
  userId             String       @unique
  fullName           String
  dateOfBirth        DateTime
  nationality        String
  address            String
  city               String
  state              String
  postalCode         String
  country            String
  documentType       DocumentType
  documentNumber     String
  documentFrontImage String
  documentBackImage  String?
  selfieImage        String
  occupation         String?
  employerName       String?
  annualIncome       String?
  sourceOfFunds      String?
  status             KYCStatus    @default(PENDING)
  rejectionReason    String?
  verifiedBy         String?
  verifiedAt         DateTime?
  submittedAt        DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("kyc_submissions")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  description String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("activity_logs")
}

model Beneficiary {
  id            String   @id @default(cuid())
  userId        String
  accountName   String
  accountNumber String
  bankName      String
  bankCode      String?
  nickname      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, accountNumber, bankName])
  @@index([userId])
  @@map("beneficiaries")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String   @default("string")
  category    String   @default("general")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model TransferOTP {
  id        String   @id @default(cuid())
  userId    String
  otp       String
  type      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type, verified])
  @@map("transfer_otps")
}

model InternationalTransfer {
  id                    String    @id @default(cuid())
  userId                String
  transactionId         String    @unique
  senderAccountId       String
  amount                Float
  currency              String
  fee                   Float
  beneficiaryName       String
  beneficiaryEmail      String?
  beneficiaryPhone      String?
  beneficiaryAddress    String
  beneficiaryCity       String?
  beneficiaryState      String?
  beneficiaryCountry    String
  beneficiaryPostalCode String?
  bankName              String
  bankAddress           String
  bankCity              String?
  bankCountry           String
  accountNumber         String
  iban                  String?
  swiftCode             String
  routingNumber         String?
  sortCode              String?
  purpose               String
  narration             String?
  status                String    @default("PENDING")
  rejectionReason       String?
  processedBy           String?
  processedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId, status])
  @@index([transactionId])
  @@map("international_transfers")
}

model Bank {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  userBankAccounts UserBankAccount[]

  @@map("banks")
}

model Currency {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  symbol    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("currencies")
}

model ChequeDeposit {
  id            String              @id @default(cuid())
  userId        String
  accountId     String
  amount        Float
  chequeImage   String
  status        ChequeDepositStatus @default(PENDING)
  submittedAt   DateTime            @default(now())
  processedAt   DateTime?
  processedBy   String?
  adminNotes    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  processorUser User?               @relation("ProcessedCheques", fields: [processedBy], references: [id])
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([status])
  @@map("cheque_deposits")
}

model UserBankAccount {
  id            String        @id @default(cuid())
  userId        String
  bankId        String
  accountName   String
  accountNumber String
  bankBranch    String?
  instructions  String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deposits      BankDeposit[]
  bank          Bank          @relation(fields: [bankId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bankId])
  @@index([userId])
  @@index([bankId])
  @@index([isActive])
  @@map("user_bank_accounts")
}

model BankDeposit {
  id                String            @id @default(cuid())
  userId            String
  userBankAccountId String
  accountId         String
  amount            Float
  referenceNumber   String
  proofImage        String?
  status            BankDepositStatus @default(PENDING)
  submittedAt       DateTime          @default(now())
  processedAt       DateTime?
  processedBy       String?
  adminNotes        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  processorUser     User?             @relation("ProcessedBankDeposits", fields: [processedBy], references: [id])
  userBankAccount   UserBankAccount   @relation(fields: [userBankAccountId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userBankAccountId])
  @@index([accountId])
  @@index([status])
  @@map("bank_deposits")
}

model TradeKey {
  id               String             @id @default(cuid())
  key              String             @unique
  userId           String
  createdBy        String?
  isActive         Boolean            @default(true)
  maxUses          Int?
  currentUses      Int                @default(0)
  expiresAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  investmentAccess InvestmentAccess[]
  creator          User?              @relation("CreatedTradeKeys", fields: [createdBy], references: [id])
  user             User               @relation("OwnedTradeKeys", fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
  @@index([isActive])
  @@map("trade_keys")
}

model InvestmentAccess {
  id         String   @id @default(cuid())
  userId     String
  tradeKeyId String
  accessedAt DateTime @default(now())
  tradeKey   TradeKey @relation(fields: [tradeKeyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tradeKeyId])
  @@index([userId])
  @@index([tradeKeyId])
  @@map("investment_access")
}

model InvestmentPlan {
  id               String       @id @default(cuid())
  planName         String
  minAmount        Float
  maxAmount        Float
  arkIIAllocation  Float
  duration         Int
  profitPercentage Float
  cryptoAddress    String?
  isActive         Boolean      @default(true)
  createdBy        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  investments      Investment[]

  @@index([isActive])
  @@map("investment_plans")
}

model Investment {
  id             String           @id @default(cuid())
  userId         String
  planId         String
  amount         Float
  paymentMethod  PaymentMethod
  transactionRef String?
  status         InvestmentStatus @default(PENDING)
  startDate      DateTime?
  endDate        DateTime?
  profitEarned   Float            @default(0)
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  plan           InvestmentPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("investments")
}

model DepositAddress {
  id              String               @id @default(cuid())
  type            String
  tokenName       String?
  address         String?
  network         String?
  bankName        String?
  accountNumber   String?
  accountName     String?
  swiftCode       String?
  routingNumber   String?
  country         String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  userAssignments UserDepositAddress[]

  @@index([type])
  @@map("deposit_addresses")
}

model UserDepositAddress {
  id        String         @id @default(cuid())
  userId    String
  addressId String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  address   DepositAddress @relation(fields: [addressId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, addressId])
  @@index([userId])
  @@index([addressId])
  @@map("user_deposit_addresses")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum AccountType {
  PERSONAL
  BUSINESS
  CORPORATE
}

enum NotificationType {
  MESSAGE
  TRANSACTION
  INVESTMENT
  LOAN
  CARD
  SECURITY
  SYSTEM
  PROMOTION
}

enum LoanType {
  PERSONAL
  BUSINESS
  AUTO
  HOME
  EDUCATION
  MEDICAL
  EMERGENCY
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  COMPLETED
  CANCELLED
}

enum CryptoDepositStatus {
  PENDING
  VERIFIED
  REJECTED
  COMPLETED
}

enum CardType {
  DEBIT
  CREDIT
  VIRTUAL
  PREPAID
}

enum CardStatus {
  PENDING
  APPROVED
  REJECTED
  ISSUED
  DELIVERED
  CANCELLED
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CLOSED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  PAYMENT
  REFUND
  FEE
  INTEREST
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  CARD_PAYMENT
  CARD_REFUND
  CRYPTO_DEPOSIT
  CRYPTO_WITHDRAWAL
  INVESTMENT
  DIVIDEND
  BONUS
  CHARGE
  REVERSAL
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum DocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
  RESIDENCE_PERMIT
}

enum KYCStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMIT_REQUIRED
}

enum ChequeDepositStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BankDepositStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  BANK_WALLET
  CRYPTO
}

enum InvestmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  FAILED
}
