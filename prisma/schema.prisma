  // Admin processing
  status            ClosureRequestStatus            @default(PENDING_APPROVAL)
  adminNotes        String?
  processedBy       String?                         // Admin ID
  processedAt       DateTime?
  rejectionReason   String?

  reference         String                          @unique
  createdAt         DateTime                        @default(now())
