generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String               @id @default(cuid())
  email                      String               @unique
  emailVerified              Boolean              @default(false)
  emailVerificationOTP       String?
  emailVerificationOTPExpiry DateTime?
  passwordResetToken         String?              @unique
  passwordResetExpiry        DateTime?
  name                       String?
  password                   String
  transactionPin             String
  phoneNumber                String
  countryCode                String
  accountType                AccountType          @default(PERSONAL)
  currency                   String
  authorizationCode          String               @unique
  avatar                     String?
  dateOfBirth                DateTime?
  address                    String?
  profileCompleted           Boolean              @default(false)
  role                       Role                 @default(USER)
  isPlusUser                 Boolean              @default(false)
  canTransfer                Boolean              @default(true)
  accountDisabled            Boolean              @default(false)
  isVerified                 Boolean              @default(false)
  requireOTPForInternational Boolean              @default(false)
  investmentBalance          Float                @default(0)
  referralBonus              Float                @default(0)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  transferDisabled           Boolean              @default(false)
  accounts                   Account[]
  activityLogs               ActivityLog[]
  cardApplications           CardApplication[]
  investmentAccess           InvestmentAccess[]
  investments                Investment[]
  investmentTransactions     InvestmentTransaction[]
  restrictedInvestmentPlans  InvestmentPlanRestriction[]
  kycSubmission              KYC?
  loanApplications           Loan[]
  receivedMessages           Message[]            @relation("ReceivedMessages")
  sentMessages               Message[]            @relation("SentMessages")
  notifications              Notification[]
  createdTradeKeys           TradeKey[]           @relation("CreatedTradeKeys")
  ownedTradeKeys             TradeKey[]           @relation("OwnedTradeKeys")
  transactions               Transaction[]
  depositAddresses           UserDepositAddress[]
  holdings                   UserHolding[]
  withdrawals                Withdrawal[]
  arkIIAssignments           ArkIIAssignment[]
  chainAccountMemberships    ChainAccountMember[]
  retirementVaults           RetirementVault[]

  @@map("users")
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  links     String?  @db.Text
  published Boolean  @default(false)
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([createdAt])
  @@map("posts")
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  subject     String
  message     String   @db.Text
  status      ContactStatus @default(PENDING)
  adminReply  String?  @db.Text
  repliedAt   DateTime?
  repliedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

model FAQ {
  id        String   @id @default(cuid())
  category  String
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("faqs")
}

model SupportRequest {
  id             String        @id @default(cuid())
  accountNumber  String
  email          String
  countryCode    String
  phoneNumber    String
  topic          String
  message        String        @db.Text
  status         ContactStatus @default(PENDING)
  adminReply     String?       @db.Text
  repliedAt      DateTime?
  repliedBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("support_requests")
}

model Message {
  id         String   @id @default(cuid())
  subject    String?
  content    String
  isRead     Boolean  @default(false)
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@index([createdAt])
  @@map("messages")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Loan {
  id         String     @id @default(cuid())
  userId     String
  fromDate   DateTime
  fullName   String
  amount     Float
  duration   Int
  loanType   LoanType
  reason     String
  status     LoanStatus @default(PENDING)
  adminNotes String?
  approvedBy String?
  approvedAt DateTime?
  rejectedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("loans")
}

model CryptoToken {
  id           String   @id @default(cuid())
  name         String
  symbol       String
  network      String
  address      String
  icon         String?
  isActive     Boolean  @default(true)
  exchangeRate Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([symbol, network])
  @@index([isActive])
  @@map("crypto_tokens")
}



model CardApplication {
  id            String     @id @default(cuid())
  userId        String
  phoneNumber   String
  accountNumber String
  cardType      CardType
  status        CardStatus @default(PENDING)
  adminNotes    String?
  approvedBy    String?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  deliveredAt   DateTime?
  // Issued card details
  cardNumber    String?    @unique
  cardBrand     String?    // VISA, MASTERCARD, AMEX
  expiryMonth   Int?
  expiryYear    Int?
  cvv           String?
  cardHolderName String?
  // Billing address
  billingAddress String?
  billingCity    String?
  billingState   String?
  billingZip     String?
  billingCountry String?
  issuedAt      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([cardNumber])
  @@map("card_applications")
}

model Account {
  id               String        @id @default(cuid())
  userId           String
  accountNumber    String        @unique
  accountName      String
  accountType      AccountType   @default(PERSONAL)
  currency         String        @default("USD")
  balance          Float         @default(0)
  availableBalance Float         @default(0)
  status           AccountStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     Transaction[]

  @@index([userId])
  @@index([accountNumber])
  @@index([status])
  @@map("accounts")
}

model Transaction {
  id                String              @id @default(cuid())
  userId            String
  accountId         String?
  transactionType   TransactionType
  amount            Float
  balanceAfter      Float
  currency          String
  description       String
  reference         String              @unique
  channel           TransactionChannel?
  paymentMethod     PaymentMethodType?
  originalReference String?
  status            TransactionStatus   @default(COMPLETED)
  recipientName     String?
  recipientAccount  String?
  recipientEmail    String?
  recipientPhone    String?
  recipientAddress  String?
  recipientCountry  String?
  senderName        String?
  senderAccount     String?
  fee               Float               @default(0)
  // For crypto transactions
  tokenName         String?
  tokenSymbol       String?
  network           String?
  walletAddress     String?
  transactionHash   String?
  // For bank/cheque transactions
  bankName          String?
  bankCode          String?
  accountNumber     String?
  routingNumber     String?
  swiftCode         String?
  iban              String?
  chequeImage       String?
  proofImage        String?
  // Admin/Processing fields
  processedAt       DateTime?
  processedBy       String?
  adminNotes        String?
  rejectionReason   String?
  // General metadata
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  account           Account?            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([channel])
  @@index([paymentMethod])
  @@index([transactionType])
  @@index([status])
  @@index([createdAt])
  @@index([reference])
  @@index([transactionHash])
  @@map("transactions")
}

model KYC {
  id                 String       @id @default(cuid())
  userId             String       @unique
  fullName           String
  dateOfBirth        DateTime
  nationality        String
  address            String
  city               String
  state              String
  postalCode         String
  country            String
  documentType       DocumentType
  documentNumber     String
  documentFrontImage String
  documentBackImage  String?
  selfieImage        String
  occupation         String?
  employerName       String?
  annualIncome       String?
  sourceOfFunds      String?
  status             KYCStatus    @default(PENDING)
  rejectionReason    String?
  verifiedBy         String?
  verifiedAt         DateTime?
  submittedAt        DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("kyc_submissions")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  description String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("activity_logs")
}

model Beneficiary {
  id            String   @id @default(cuid())
  userId        String
  accountName   String
  accountNumber String
  bankName      String
  bankCode      String?
  nickname      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, accountNumber, bankName])
  @@index([userId])
  @@map("beneficiaries")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String   @default("string")
  category    String   @default("general")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model TransferOTP {
  id        String   @id @default(cuid())
  userId    String
  otp       String
  type      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type, verified])
  @@map("transfer_otps")
}



model Bank {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banks")
}

model Currency {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  symbol       String
  exchangeRate Float    @default(1) // Rate relative to USD (1 USD = X currency)
  isActive     Boolean  @default(true)
  lastSynced   DateTime? // Last time rate was synced from API
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("currencies")
}







model TradeKey {
  id               String             @id @default(cuid())
  key              String             @unique
  userId           String?
  createdBy        String?
  isActive         Boolean            @default(true)
  maxUses          Int?
  currentUses      Int                @default(0)
  expiresAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  investmentAccess InvestmentAccess[]
  creator          User?              @relation("CreatedTradeKeys", fields: [createdBy], references: [id])
  user             User?              @relation("OwnedTradeKeys", fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
  @@index([isActive])
  @@map("trade_keys")
}

model InvestmentAccess {
  id         String   @id @default(cuid())
  userId     String
  tradeKeyId String
  accessedAt DateTime @default(now())
  tradeKey   TradeKey @relation(fields: [tradeKeyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tradeKeyId])
  @@index([userId])
  @@index([tradeKeyId])
  @@map("investment_access")
}

model InvestmentPlan {
  id                   String       @id @default(cuid())
  planName             String
  minAmount            Float
  maxAmount            Float
  arkIIAllocation      Float
  duration             Int
  profitPercentage     Float
  compoundingCycles    Int          @default(0) // Number of times to repeat (0 = no compounding)
  canBeStoppedByUser   Boolean      @default(true) // Allow users to stop compounding early
  cryptoAddress        String?
  cryptoSymbol         String?
  cryptoIcon           String?      @db.Text
  isActive             Boolean      @default(true)
  chainAccountsEnabled Boolean      @default(false) // Show in Chain Account dashboard
  createdBy            String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  investments          Investment[]
  restrictions         InvestmentPlanRestriction[]
  chainInvestments     ChainAccountInvestment[]

  @@index([isActive])
  @@map("investment_plans")
}

model InvestmentPlanRestriction {
  id        String         @id @default(cuid())
  userId    String
  planId    String
  createdAt DateTime       @default(now())
  createdBy String?        // Admin who created the restriction
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      InvestmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
  @@index([userId])
  @@index([planId])
  @@map("investment_plan_restrictions")
}

model Investment {
  id                    String           @id @default(cuid())
  userId                String
  planId                String
  amount                Float
  paymentMethod         PaymentMethod
  transactionRef        String?
  status                InvestmentStatus @default(PENDING)
  startDate             DateTime?
  endDate               DateTime?
  profitEarned          Float            @default(0)
  currentCycle          Int              @default(1) // Track which compounding cycle we're on
  totalCycles           Int              @default(1) // Total cycles based on plan's compoundingCycles
  isStopped             Boolean          @default(false) // Track if user/admin stopped compounding
  stoppedBy             String?          // User ID or 'ADMIN' who stopped it
  stoppedAt             DateTime?        // When it was stopped
  completedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  plan                  InvestmentPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("investments")
}

model InvestmentTransaction {
  id                 String                    @id @default(cuid())
  userId             String
  transactionType    InvestmentTransactionType
  amount             Float
  balanceBefore      Float
  balanceAfter       Float
  description        String
  reference          String                    @unique
  status             TransactionStatus         @default(COMPLETED)
  investmentId       String?
  relatedAccountId   String?
  metadata           Json?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionType])
  @@index([status])
  @@index([createdAt])
  @@index([reference])
  @@map("investment_transactions")
}
model DepositAddress {
  id              String               @id @default(cuid())
  type            String
  tokenName       String?
  address         String?
  network         String?
  bankName        String?
  accountNumber   String?
  accountName     String?
  swiftCode       String?
  routingNumber   String?
  country         String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  userAssignments UserDepositAddress[]

  @@index([type])
  @@map("deposit_addresses")
}

model UserDepositAddress {
  id        String         @id @default(cuid())
  userId    String
  addressId String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  address   DepositAddress @relation(fields: [addressId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, addressId])
  @@index([userId])
  @@index([addressId])
  @@map("user_deposit_addresses")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum AccountType {
  PERSONAL
  BUSINESS
  CORPORATE
}

enum NotificationType {
  MESSAGE
  TRANSACTION
  INVESTMENT
  LOAN
  CARD
  SECURITY
  SYSTEM
  PROMOTION
}

enum LoanType {
  PERSONAL
  BUSINESS
  AUTO
  HOME
  EDUCATION
  MEDICAL
  EMERGENCY
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  COMPLETED
  CANCELLED
}



enum CardType {
  DEBIT
  CREDIT
  VIRTUAL
  PREPAID
}

enum CardStatus {
  PENDING
  APPROVED
  REJECTED
  ISSUED
  DELIVERED
  CANCELLED
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CLOSED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  PAYMENT
  REFUND
  FEE
  INTEREST
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  CARD_PAYMENT
  CARD_REFUND
  INVESTMENT
  INVESTMENT_DEPOSIT
  INVESTMENT_WITHDRAWAL
  DIVIDEND
  BONUS
  CHARGE
  REVERSAL
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum TransactionChannel {
  BANK
  CRYPTO
  CHEQUE
  DOMESTIC
  INTERNATIONAL
  INTERNAL
  SYSTEM
}

enum DocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
  RESIDENCE_PERMIT
}

enum KYCStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMIT_REQUIRED
}

enum InvestmentTransactionType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT_PURCHASE
  INVESTMENT_PROFIT
  INVESTMENT_RETURN
  FEE
  BONUS
  REFUND
  ADJUSTMENT
}



enum PaymentMethod {
  BANK_WALLET
  CRYPTO
}

enum PaymentMethodType {
  BANK
  CRYPTO
  CHEQUE
  CASH
  CARD
  WALLET
}

enum InvestmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  FAILED
}

enum ContactStatus {
  PENDING
  REPLIED
  CLOSED
}

model HoldingToken {
  id              String        @id @default(cuid())
  name            String        // e.g., "Bitcoin"
  symbol          String        @unique // e.g., "BTC"
  logo            String?       // Base64 or URL
  tokenAddress    String?       // Deposit address
  currentPrice    Float         @default(0)
  priceChange24h  Float         @default(0)
  interestRate    Float         @default(0) // Annual interest rate in percentage
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userHoldings    UserHolding[]
  chainAccountHoldings ChainAccountHolding[]

  @@map("holding_tokens")
}

model UserHolding {
  id                String        @id @default(cuid())
  userId            String
  tokenId           String
  depositedAmount   Float         // Original amount deposited in user's currency
  tokenAmount       Float         // Amount in tokens (calculated at deposit time)
  currentValue      Float         // Current value in user's currency
  interestEarned    Float         @default(0)
  status            HoldingStatus @default(PENDING)
  adminNotes        String?       // Admin notes for approval/rejection
  processedBy       String?       // Admin who approved/rejected
  processedAt       DateTime?     // When it was processed
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  token             HoldingToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenId])
  @@index([status])
  @@map("user_holdings")
}

enum HoldingStatus {
  PENDING
  ACTIVE
  WITHDRAWN
  REJECTED
  CLOSED
}

model Withdrawal {
  id                  String            @id @default(cuid())
  userId              String
  accountId           String?
  amount              Float
  currency            String            @default("USD")
  method              WithdrawalMethod  @default(BANK)

  // Beneficiary Details
  beneficiaryName     String?
  beneficiaryEmail    String?
  beneficiaryPhone    String?

  // Bank Details
  bankName            String?
  bankAddress         String?
  accountNumber       String?
  swiftCode           String?
  iban                String?
  routingNumber       String?
  sortCode            String?

  // Beneficiary Address
  beneficiaryAddress  String?
  city                String?
  state               String?
  zipCode             String?
  countryCode         String?

  // Crypto Details
  cryptoToken         String?
  cryptoNetwork       String?
  cryptoAddress       String?

  // Transaction Details
  reference           String            @unique
  status              WithdrawalStatus  @default(PENDING)
  description         String?
  fee                 Float             @default(0)
  totalAmount         Float             // amount + fee

  // Admin Actions
  adminNotes          String?
  processedBy         String?
  processedAt         DateTime?
  rejectionReason     String?

  // Timestamps
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("withdrawals")
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum WithdrawalMethod {
  BANK
  CRYPTO
}

model ArkIIAssignment {
  id          String   @id @default(cuid())
  userId      String
  amount      Float                             // The ARK II amount assigned
  notes       String?                           // Optional admin notes
  assignedBy  String                            // Admin ID who assigned it
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ark_ii_assignments")
}

// ==================== CHAIN ACCOUNT MODELS ====================

model ChainAccount {
  id                     String                       @id @default(cuid())
  accountName            String                       // Auto-generated from member names
  accountNumber          String                       @unique // CA-[AUTO-GENERATED]
  
  // Application Form Data
  primaryPurpose         String                       // Business Operations, Investment Partnership, etc.
  purposeDescription     String                       @db.Text
  numberOfParties        Int                          // 2, 3, or 4
  relationship           String                       // Spouses, Business Partners, etc.
  expectedMonthlyVolume  String                       // Under $5,000, etc.
  combinedCapitalLevel   String                       // Under $50,000, etc.
  intendedAssetHoldings  String                       // Crypto only, Fiat only, Both, Investment portfolio
  
  // Permission Model
  authorizationModel     ChainAuthModel               // INDEPENDENT, THRESHOLD, MAJORITY
  thresholdAmount        Float?                       // Transaction threshold amount
  thresholdCurrency      String?                      @default("USD")
  
  // Account Status & Balance
  status                 ChainAccountStatus           @default(PENDING)
  balance                Float                        @default(0)
  currency               String                       @default("USDT") // Chain Accounts operate in USDT

  // Crypto Deposit Address (Admin-assigned)
  cryptoDepositAddress   String?                      // Admin assigns unique deposit address
  cryptoNetwork          String?                      // e.g., TRC20, ERC20
  cryptoToken            String?                      // e.g., USDT
  depositAddressAssignedAt DateTime?
  depositAddressAssignedBy String?                    // Admin ID who assigned

  // Dormancy & Freezing (from Memorandum legal terms)
  isDormant              Boolean                      @default(false)
  dormancyFlaggedAt      DateTime?                    // When flagged for 180 days inactivity
  isFrozen               Boolean                      @default(false)
  frozenAt               DateTime?
  frozenBy               String?                      // Admin ID who froze the account
  frozenReason           String?                      @db.Text
  lastActivityAt         DateTime?                    // Track last deposit/withdrawal/investment activity

  // Metadata
  createdBy              String                       // Primary Holder user ID
  activatedAt            DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  
  // Relations
  members                ChainAccountMember[]
  memorandum             ChainAccountMemorandum?
  deposits               ChainAccountDeposit[]
  investments            ChainAccountInvestment[]
  withdrawals            ChainAccountWithdrawal[]
  holdings               ChainAccountHolding[]
  approvals              ChainAccountApproval[]
  transactions           ChainAccountTransaction[]
  notifications          ChainAccountNotification[]
  removalRequests        ChainAccountRemovalRequest[]
  modificationRequests   ChainAccountModificationRequest[]
  closureRequests        ChainAccountClosureRequest[]

  @@index([accountNumber])
  @@index([status])
  @@index([createdBy])
  @@map("chain_accounts")
}

model ChainAccountMember {
  id                String               @id @default(cuid())
  chainAccountId    String
  userId            String
  role              ChainMemberRole      // PRIMARY_HOLDER or CO_SIGNATORY
  
  // Access Token - stored hashed
  accessTokenHash   String?              // Unique 6-10 char alphanumeric token (hashed)
  tokenGeneratedAt  DateTime?
  
  // Confirmation Status
  hasConfirmed      Boolean              @default(false)
  confirmedAt       DateTime?
  signingToken      String?              @unique // One-time token for memorandum signing link
  signingTokenUsed  Boolean              @default(false)
  
  // Metadata
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  
  chainAccount      ChainAccount         @relation(fields: [chainAccountId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvals         ChainAccountApproval[]
  initiatedDeposits ChainAccountDeposit[] @relation("DepositInitiator")
  initiatedInvestments ChainAccountInvestment[] @relation("InvestmentInitiator")
  initiatedWithdrawals ChainAccountWithdrawal[] @relation("WithdrawalInitiator")
  initiatedHoldings ChainAccountHolding[] @relation("HoldingInitiator")

  @@unique([chainAccountId, userId])
  @@index([userId])
  @@index([chainAccountId])
  @@index([signingToken])
  @@map("chain_account_members")
}

model ChainAccountMemorandum {
  id                String       @id @default(cuid())
  chainAccountId    String       @unique
  documentReference String       @unique // CA-2024-00142
  
  // Generated Document Content (JSON)
  content           Json         // Full memorandum data
  
  // Status
  status            MemorandumStatus @default(PENDING)
  activatedAt       DateTime?
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  
  chainAccount      ChainAccount @relation(fields: [chainAccountId], references: [id], onDelete: Cascade)

  @@index([chainAccountId])
  @@index([documentReference])
  @@map("chain_account_memorandums")
}

model ChainAccountDeposit {
  id                String               @id @default(cuid())
  chainAccountId    String
  initiatedBy       String               // Member ID who initiated
  userId            String               // User ID of the initiator
  
  amount            Float
  currency          String               @default("USD")
  method            DepositMethod        // WALLET or CRYPTO
  
  // For wallet deposits
  deductedFromWallet Boolean             @default(false)
  
  // For crypto deposits
  transactionHash   String?
  cryptoNetwork     String?
  cryptoToken       String?
  
  // Status & Processing
  status            DepositStatus        @default(PENDING)
  adminNotes        String?
  processedBy       String?              // Admin ID
  processedAt       DateTime?
  rejectionReason   String?
  
  // Metadata
  reference         String               @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  
  chainAccount      ChainAccount         @relation(fields: [chainAccountId], references: [id], onDelete: Cascade)
  initiator         ChainAccountMember   @relation("DepositInitiator", fields: [initiatedBy], references: [id], onDelete: Cascade)

  @@index([chainAccountId])
  @@index([status])
  @@index([initiatedBy])
  @@map("chain_account_deposits")
}

model ChainAccountInvestment {
  id                String                  @id @default(cuid())
  chainAccountId    String
  initiatedBy       String                  // Member ID who initiated
  planId            String
  
  amount            Float
  currency          String                  @default("USD")
  
  // Approval flow
  requiresApproval  Boolean                 @default(false)
  allApproved       Boolean                 @default(false)
  
  // Investment lifecycle
  status            ChainInvestmentStatus   @default(PENDING_APPROVAL)
  startDate         DateTime?
  endDate           DateTime?
  profitEarned      Float                   @default(0)
  completedAt       DateTime?

  // Early close request (member-initiated, admin-approved)
  closeRequestedBy   String?                // Member ID who requested the early close
  closeRequestedAt   DateTime?
  closeRequestReason String?                @db.Text
  adminNotes         String?
  processedBy        String?                // Admin ID who approved/rejected the close request
  processedAt        DateTime?

  // Metadata
  reference         String                  @unique
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  chainAccount      ChainAccount            @relation(fields: [chainAccountId], references: [id], onDelete: Cascade)
  initiator         ChainAccountMember      @relation("InvestmentInitiator", fields: [initiatedBy], references: [id], onDelete: Cascade)
  plan              InvestmentPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([chainAccountId])
  @@index([status])
  @@index([initiatedBy])
  @@index([planId])
  @@map("chain_account_investments")
}

model ChainAccountWithdrawal {
  id                String                   @id @default(cuid())
  chainAccountId    String
  initiatedBy       String                   // Member ID who initiated
  
  totalAmount       Float
  currency          String                   @default("USD")
  
  // Per-member distribution (JSON array)
  distribution      Json                     // [{ userId: string, amount: number, name: string }]
  
  // Approval flow
  requiresApproval  Boolean                  @default(false)
  allApproved       Boolean                  @default(false)
  
  // Processing
  status            ChainWithdrawalStatus    @default(PENDING_APPROVAL)
  adminNotes        String?
  processedBy       String?                  // Admin ID
  processedAt       DateTime?
  rejectionReason   String?
  
  // Metadata
  reference         String                   @unique
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  
  chainAccount      ChainAccount             @relation(fields: [chainAccountId], references: [id], onDelete: Cascade)
  initiator         ChainAccountMember       @relation("WithdrawalInitiator", fields: [initiatedBy], references: [id], onDelete: Cascade)

  @@index([chainAccountId])
  @@index([status])
  @@index([initiatedBy])
  @@map("chain_account_withdrawals")
}

model ChainAccountHolding {
  id                String               @id @default(cuid())
  chainAccountId    String
  initiatedBy       String               // Member ID who initiated
  userId            String               // User ID of the initiator
  tokenId           String

  depositedAmount   Float                // Amount deducted from Chain Account balance (USDT)
  tokenAmount       Float                // Amount in tokens (calculated at request/approval time)
  currentValue      Float                // Current value in USD
  interestEarned    Float                @default(0)

  status            HoldingStatus        @default(PENDING)
  adminNotes        String?
  processedBy       String?              // Admin ID who approved/rejected
  processedAt       DateTime?

  reference         String               @unique
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  chainAccount      ChainAccount         @relation(fields: [chainAccountId], references: [id], onDelete: Cascade)
  initiator         ChainAccountMember   @relation("HoldingInitiator", fields: [initiatedBy], references: [id], onDelete: Cascade)
  token             HoldingToken         @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([chainAccountId])
  @@index([tokenId])
  @@index([status])
  @@index([initiatedBy])
  @@map("chain_account_holdings")
}

model ChainAccountApproval {
  id                String               @id @default(cuid())
  chainAccountId    String
  memberId          String               // Member who needs to approve
  
  // What needs approval
  actionType        ChainActionType      // INVESTMENT or WITHDRAWAL
  actionId          String               // ID of the investment or withdrawal
  
  // Approval status
  status            ApprovalStatus       @default(PENDING)
  decision          ApprovalDecision?    // APPROVED or REJECTED
  decidedAt         DateTime?
  notes             String?              // Optional notes from approver

  // One-time token for the email approval link (no login required)
  approvalToken     String?              @unique
  approvalTokenUsed Boolean              @default(false)

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  chainAccount      ChainAccount         @relation(fields: [chainAccountId], references: [id], onDelete: Cascade)
  member            ChainAccountMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, actionType, actionId])
  @@index([chainAccountId])
  @@index([memberId])
  @@index([status])
  @@index([approvalToken])
  @@map("chain_account_approvals")
}

model ChainAccountTransaction {
  id                String                  @id @default(cuid())
  chainAccountId    String
  
  transactionType   ChainTransactionType
  amount            Float
  balanceBefore     Float
  balanceAfter      Float
  currency          String                  @default("USD")
  
  description       String
  reference         String                  @unique
  
  // Related entities
  relatedUserId     String?                 // User who initiated
  relatedDepositId  String?
  relatedInvestmentId String?
  relatedWithdrawalId String?
  
  metadata          Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  
  chainAccount      ChainAccount            @relation(fields: [chainAccountId], references: [id], onDelete: Cascade)

  @@index([chainAccountId])
  @@index([transactionType])
  @@index([createdAt])
  @@index([reference])
  @@map("chain_account_transactions")
}

model ChainAccountNotification {
  id                String                     @id @default(cuid())
  chainAccountId    String
  userId            String                     // Recipient user ID
  
  type              ChainNotificationType
  title             String
  message           String                     @db.Text
  
  // For approval notifications
  actionType        ChainActionType?
  actionId          String?
  
  isRead            Boolean                    @default(false)
  readAt            DateTime?
  
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  
  chainAccount      ChainAccount               @relation(fields: [chainAccountId], references: [id], onDelete: Cascade)

  @@index([chainAccountId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("chain_account_notifications")
}

model ChainAccountRemovalRequest {
  id                String                        @id @default(cuid())
  chainAccountId    String
  initiatedBy       String                        // Member ID who initiated removal
  targetMemberId    String                        // Member to be removed

  reason            String                        @db.Text

  // Approval flow
  targetApproved    Boolean                       @default(false)
  targetApprovedAt  DateTime?
  allApproved       Boolean                       @default(false)

  // Admin processing
  status            RemovalRequestStatus          @default(PENDING_TARGET_APPROVAL)
  adminNotes        String?
  processedBy       String?                       // Admin ID
  processedAt       DateTime?
