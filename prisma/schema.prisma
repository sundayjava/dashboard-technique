  chainAccount      ChainAccount                    @relation(fields: [chainAccountId], references: [id], onDelete: Cascade)
  approvals         ChainAccountClosureApproval[]

  @@index([chainAccountId])
  @@index([status])
  @@index([initiatedBy])
  @@map("chain_account_closure_requests")
