model ChainAccountRemovalApproval {
  id                String                        @id @default(cuid())
  removalRequestId  String
  memberId          String                        // Member who needs to approve

  decision          ApprovalDecision?             // APPROVED or REJECTED
  decidedAt         DateTime?
  notes             String?

  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  removalRequest    ChainAccountRemovalRequest    @relation(fields: [removalRequestId], references: [id], onDelete: Cascade)

  @@unique([removalRequestId, memberId])
  @@index([removalRequestId])
  @@index([memberId])
  @@map("chain_account_removal_approvals")
}

model ChainAccountModificationRequest {
  id                     String                              @id @default(cuid())
  chainAccountId         String
  initiatedBy            String                              // Member ID who initiated

