// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Example Models - Customize according to your needs

model User {
  id                         String            @id @default(cuid())
  email                      String            @unique
  emailVerified              Boolean           @default(false)
  emailVerificationOTP       String?
  emailVerificationOTPExpiry DateTime?
  passwordResetToken         String?           @unique
  passwordResetExpiry        DateTime?
  name                       String?
  password                   String
  transactionPin             String
  phoneNumber                String
  countryCode                String
  accountType                AccountType       @default(PERSONAL)
  currency                   String
  authorizationCode          String            @unique
  avatar                     String?
  dateOfBirth                DateTime?
  address                    String?
  profileCompleted           Boolean           @default(false)
  role                       Role              @default(USER)
  isPlusUser                 Boolean           @default(false)
  // Admin controls
  canTransfer                Boolean           @default(true)
  accountDisabled            Boolean           @default(false)
  isVerified                 Boolean           @default(false)
  requireOTPForInternational Boolean           @default(false)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  sentMessages               Message[]         @relation("SentMessages")
  receivedMessages           Message[]         @relation("ReceivedMessages")
  notifications              Notification[]
  loanApplications           Loan[]
  cryptoDeposits             CryptoDeposit[]
  cardApplications           CardApplication[]
  accounts                   Account[]
  transactions               Transaction[]
  kycSubmission              KYC?
  activityLogs               ActivityLog[]
  chequeDeposits             ChequeDeposit[]
  processedChequeDeposits    ChequeDeposit[]    @relation("ProcessedCheques")
  assignedBankAccounts       UserBankAccount[]
  bankDeposits               BankDeposit[]
  processedBankDeposits      BankDeposit[]      @relation("ProcessedBankDeposits")
  ownedTradeKeys             TradeKey[]         @relation("OwnedTradeKeys")
  createdTradeKeys           TradeKey[]         @relation("CreatedTradeKeys")
  investmentAccess           InvestmentAccess[]
  investments                Investment[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum AccountType {
  PERSONAL
  BUSINESS
  CORPORATE
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  published Boolean  @default(false)
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}

model FAQ {
  id        String   @id @default(cuid())
  category  String
  question  String   @db.Text
  answer    String   @db.Text
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("faqs")
}

model Message {
  id         String   @id @default(cuid())
  subject    String?
  content    String   @db.Text
  isRead     Boolean  @default(false)
  senderId   String
  receiverId String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@index([createdAt])
  @@map("messages")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  isRead    Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  MESSAGE
  TRANSACTION
  INVESTMENT
  LOAN
  CARD
  SECURITY
  SYSTEM
  PROMOTION
}

model Loan {
  id         String     @id @default(cuid())
  userId     String
  fromDate   DateTime
  fullName   String
  amount     Float
  duration   Int // in months
  loanType   LoanType
  reason     String     @db.Text
  status     LoanStatus @default(PENDING)
  adminNotes String?    @db.Text
  approvedBy String?
  approvedAt DateTime?
  rejectedAt DateTime?
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("loans")
}

enum LoanType {
  PERSONAL
  BUSINESS
  AUTO
  HOME
  EDUCATION
  MEDICAL
  EMERGENCY
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  COMPLETED
  CANCELLED
}

model CryptoToken {
  id           String          @id @default(cuid())
  name         String // Bitcoin, Ethereum, etc.
  symbol       String // BTC, ETH, etc.
  network      String // Bitcoin Network, Ethereum (ERC20), etc.
  address      String // Deposit address
  icon         String? // URL to token icon
  isActive     Boolean         @default(true)
  exchangeRate Float           @default(0) // Rate against USD
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deposits     CryptoDeposit[]

  @@unique([symbol, network])
  @@index([isActive])
  @@map("crypto_tokens")
}

model CryptoDeposit {
  id            String              @id @default(cuid())
  userId        String
  tokenId       String
  amount        Float
  transactionId String
  status        CryptoDepositStatus @default(PENDING)
  adminNotes    String?             @db.Text
  verifiedBy    String?
  verifiedAt    DateTime?
  rejectedAt    DateTime?
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         CryptoToken         @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId])
  @@index([tokenId])
  @@index([status])
  @@index([createdAt])
  @@map("crypto_deposits")
}

enum CryptoDepositStatus {
  PENDING
  VERIFIED
  REJECTED
  COMPLETED
}

model CardApplication {
  id            String     @id @default(cuid())
  userId        String
  phoneNumber   String
  accountNumber String
  cardType      CardType
  status        CardStatus @default(PENDING)
  adminNotes    String?    @db.Text
  approvedBy    String?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  deliveredAt   DateTime?
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("card_applications")
}

enum CardType {
  DEBIT
  CREDIT
  VIRTUAL
  PREPAID
}

enum CardStatus {
  PENDING
  APPROVED
  REJECTED
  ISSUED
  DELIVERED
  CANCELLED
}

model Account {
  id              String        @id @default(cuid())
  userId          String
  accountNumber   String        @unique
  accountName     String
  accountType     AccountType   @default(PERSONAL)
  currency        String        @default("USD")
  balance         Float         @default(0)
  availableBalance Float        @default(0)
  status          AccountStatus @default(ACTIVE)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([accountNumber])
  @@index([status])
  @@map("accounts")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CLOSED
}

model Transaction {
  id                String            @id @default(cuid())
  userId            String
  accountId         String
  transactionType   TransactionType
  amount            Float
  balanceAfter      Float
  currency          String
  description       String
  reference         String            @unique
  status            TransactionStatus @default(COMPLETED)
  recipientName     String?
  recipientAccount  String?
  senderName        String?
  senderAccount     String?
  fee               Float             @default(0)
  metadata          Json?
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId])
  @@index([accountId])
  @@index([transactionType])
  @@index([status])
  @@index([createdAt])
  @@index([reference])
  @@map("transactions")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  PAYMENT
  REFUND
  FEE
  INTEREST
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  CARD_PAYMENT
  CARD_REFUND
  CRYPTO_DEPOSIT
  CRYPTO_WITHDRAWAL
  INVESTMENT
  DIVIDEND
  BONUS
  CHARGE
  REVERSAL
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

model KYC {
  id                 String       @id @default(cuid())
  userId             String       @unique
  // Personal Information
  fullName           String
  dateOfBirth        DateTime
  nationality        String
  address            String       @db.Text
  city               String
  state              String
  postalCode         String
  country            String
  // Identity Document
  documentType       DocumentType
  documentNumber     String
  documentFrontImage String // URL to uploaded image
  documentBackImage  String? // URL to uploaded image (optional for some documents)
  // Selfie Verification
  selfieImage        String // URL to uploaded selfie
  // Additional Information
  occupation         String?
  employerName       String?
  annualIncome       String?
  sourceOfFunds      String?
  // Verification Status
  status             KYCStatus    @default(PENDING)
  rejectionReason    String?      @db.Text
  verifiedBy         String? // Admin ID who verified
  verifiedAt         DateTime?
  submittedAt        DateTime     @default(now())
  // Relations
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("kyc_submissions")
}

enum DocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
  RESIDENCE_PERMIT
}

enum KYCStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMIT_REQUIRED
}

model ActivityLog {
  id          String       @id @default(cuid())
  userId      String
  action      String       // e.g., "LOGIN", "PASSWORD_CHANGED", "PIN_CHANGED", "PROFILE_UPDATED"
  description String       @db.Text
  ipAddress   String?
  userAgent   String?      @db.Text
  metadata    Json?        // Additional data
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("activity_logs")
}

model Beneficiary {
  id            String   @id @default(cuid())
  userId        String
  accountName   String
  accountNumber String
  bankName      String
  bankCode      String?
  nickname      String?  // Optional friendly name for the beneficiary
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@unique([userId, accountNumber, bankName])
  @@map("beneficiaries")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string") // string, number, boolean, json
  category  String   @default("general") // general, fees, limits, notifications
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model TransferOTP {
  id        String   @id @default(cuid())
  userId    String
  otp       String
  type      String   // 'international_transfer' or 'domestic_transfer'
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type, verified])
  @@map("transfer_otps")
}

model InternationalTransfer {
  id                    String   @id @default(cuid())
  userId                String
  transactionId         String   @unique
  // Sender details
  senderAccountId       String
  amount                Float
  currency              String
  fee                   Float
  // Beneficiary details
  beneficiaryName       String
  beneficiaryEmail      String?
  beneficiaryPhone      String?
  beneficiaryAddress    String
  beneficiaryCity       String?
  beneficiaryState      String?
  beneficiaryCountry    String
  beneficiaryPostalCode String?
  // Bank details
  bankName              String
  bankAddress           String
  bankCity              String?
  bankCountry           String
  accountNumber         String
  iban                  String?
  swiftCode             String
  routingNumber         String?
  sortCode              String?
  // Transfer details
  purpose               String
  narration             String?
  status                String   @default("PENDING") // PENDING, COMPLETED, REJECTED
  rejectionReason       String?
  processedBy           String?
  processedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, status])
  @@index([transactionId])
  @@map("international_transfers")
}

model Bank {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  isActive         Boolean           @default(true)
  userBankAccounts UserBankAccount[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("banks")
}

model Currency {
  id        String   @id @default(cuid())
  code      String   @unique // USD, EUR, GBP, etc.
  name      String   // US Dollar, Euro, British Pound
  symbol    String   // $, €, £
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("currencies")
}

model ChequeDeposit {
  id            String              @id @default(cuid())
  userId        String
  accountId     String
  amount        Float
  chequeImage   String              // Path to uploaded cheque image
  status        ChequeDepositStatus @default(PENDING)
  submittedAt   DateTime            @default(now())
  processedAt   DateTime?
  processedBy   String?             // Admin user ID who processed it
  adminNotes    String?
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  processorUser User?               @relation("ProcessedCheques", fields: [processedBy], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId])
  @@index([accountId])
  @@index([status])
  @@map("cheque_deposits")
}

enum ChequeDepositStatus {
  PENDING
  APPROVED
  REJECTED
}

model UserBankAccount {
  id            String        @id @default(cuid())
  userId        String
  bankId        String
  accountName   String        // Name on the bank account
  accountNumber String        // Bank account number to deposit to
  bankBranch    String?       // Optional branch information
  instructions  String?       @db.Text // Optional special instructions
  isActive      Boolean       @default(true)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank          Bank          @relation(fields: [bankId], references: [id], onDelete: Cascade)
  deposits      BankDeposit[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([userId, bankId]) // One bank account per bank per user
  @@index([userId])
  @@index([bankId])
  @@index([isActive])
  @@map("user_bank_accounts")
}

model BankDeposit {
  id              String            @id @default(cuid())
  userId          String
  userBankAccountId String
  accountId       String            // User's account to credit
  amount          Float
  referenceNumber String            // Transaction reference from user
  proofImage      String?           // Optional proof of payment
  status          BankDepositStatus @default(PENDING)
  submittedAt     DateTime          @default(now())
  processedAt     DateTime?
  processedBy     String?           // Admin user ID
  adminNotes      String?
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userBankAccount UserBankAccount   @relation(fields: [userBankAccountId], references: [id], onDelete: Cascade)
  processorUser   User?             @relation("ProcessedBankDeposits", fields: [processedBy], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([userBankAccountId])
  @@index([accountId])
  @@index([status])
  @@map("bank_deposits")
}

enum BankDepositStatus {
  PENDING
  APPROVED
  REJECTED
}

model TradeKey {
  id               String             @id @default(cuid())
  key              String             @unique // The actual trade/referral key
  userId           String             // Owner of the key
  createdBy        String?            // Admin who created it (if admin-created)
  isActive         Boolean            @default(true)
  maxUses          Int?               // Maximum number of times this key can be used (null = unlimited)
  currentUses      Int                @default(0)
  expiresAt        DateTime?          // Optional expiration date
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation("OwnedTradeKeys", fields: [userId], references: [id], onDelete: Cascade)
  creator          User?              @relation("CreatedTradeKeys", fields: [createdBy], references: [id])
  investmentAccess InvestmentAccess[]

  @@index([key])
  @@index([userId])
  @@index([isActive])
  @@map("trade_keys")
}

model InvestmentAccess {
  id          String    @id @default(cuid())
  userId      String    // User who got access
  tradeKeyId  String    // Trade key used to get access
  accessedAt  DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeKey    TradeKey  @relation(fields: [tradeKeyId], references: [id], onDelete: Cascade)

  @@unique([userId, tradeKeyId])
  @@index([userId])
  @@index([tradeKeyId])
  @@map("investment_access")
}

model InvestmentPlan {
  id                String           @id @default(cuid())
  planName          String
  minAmount         Float
  maxAmount         Float
  arkIIAllocation   Float            // Percentage allocated to ARK_II
  duration          Int              // in days
  profitPercentage  Float            // Expected profit percentage
  cryptoAddress     String?          // Crypto payment address for this plan
  isActive          Boolean          @default(true)
  createdBy         String?          // Admin who created the plan
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  investments       Investment[]

  @@index([isActive])
  @@map("investment_plans")
}

model Investment {
  id              String           @id @default(cuid())
  userId          String
  planId          String
  amount          Float
  paymentMethod   PaymentMethod
  transactionRef  String?          // Reference for crypto payments
  status          InvestmentStatus @default(PENDING)
  startDate       DateTime?
  endDate         DateTime?
  profitEarned    Float            @default(0)
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            InvestmentPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("investments")
}

enum PaymentMethod {
  BANK_WALLET
  CRYPTO
}

enum InvestmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  FAILED
}
