  @@index([chainAccountId])
  @@index([status])
  @@index([initiatedBy])
  @@map("chain_account_modification_requests")
}

model ChainAccountModificationApproval {
  id                     String                              @id @default(cuid())
  modificationRequestId  String
  memberId               String                              // Member who needs to approve

  decision               ApprovalDecision?                   // APPROVED or REJECTED
  decidedAt              DateTime?
  notes                  String?

  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt

  modificationRequest    ChainAccountModificationRequest     @relation(fields: [modificationRequestId], references: [id], onDelete: Cascade)

  @@unique([modificationRequestId, memberId])
  @@index([modificationRequestId])
  @@index([memberId])
  @@map("chain_account_modification_approvals")
}

model ChainAccountClosureRequest {
  id                String                          @id @default(cuid())
  chainAccountId    String
  initiatedBy       String                          // Member ID who initiated

  reason            String                          @db.Text

  // Approval flow
